# ── Polygon zkEVM RPC ────────────────────────────────────────────────────────
POLYGON_ZKEVM_RPC_URL=https://zkevm-rpc.com
POLYGON_ZKEVM_WS_URL=wss://zkevm-rpc.com/ws

# ── Wallet ───────────────────────────────────────────────────────────────────
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0x_YOUR_WALLET_ADDRESS_HERE

# ── Aave V3 ──────────────────────────────────────────────────────────────────
AAVE_POOL_ADDRESS=0xb47673b7a73D78743AFF1487AF69dBB5763F00cA
FLASH_LOAN_ARBITRAGE_CONTRACT=0x_YOUR_DEPLOYED_CONTRACT_ADDRESS

# ── DEX Routers (Polygon zkEVM) ───────────────────────────────────────────────
UNISWAP_V3_FACTORY=0x4B9f4d2435Ef65559567e5DbFC1BbB37abC43B57
QUICKSWAP_V3_FACTORY=0x411b0fAcC3489691f28ad58c47006AF5E3Ab3A28
SUSHISWAP_FACTORY=0xc35DADB65012eC5796536bD9864eD8773aBc74C4

# ── AI Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=sk-or-YOUR_OPENROUTER_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

# ── Bot Configuration ─────────────────────────────────────────────────────────
MIN_PROFIT_USD=5.0
MAX_GAS_PRICE_GWEI=500
ML_SCORE_THRESHOLD=0.60
POLL_INTERVAL_SECONDS=2
FLASH_LOAN_PREMIUM_BPS=5

# ── DEX Pool Feed ─────────────────────────────────────────────────────────────
# Comma-separated list of dex_name:pool_address pairs to monitor.
# Verify pool addresses on-chain before use (e.g. via DexScreener or the DEX UI).
# Example:
#   POOL_CONFIGS=quickswap_v3:0xCBa7d7F7c4b97B0eFeBa5e00Bc2Fcd71E4bA9e5A,uniswap_v3:0x<addr>
POOL_CONFIGS=

LOG_LEVEL=INFO
LOG_FILE=logs/arbisy.log
